<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/amalmaki/ontologies/2026/10/untitled-ontology-13/"
     xml:base="http://www.semanticweb.org/amalmaki/ontologies/2026/10/untitled-ontology-13/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="http://www.semanticweb.org/group2/languages/core#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:features="http://www.semanticweb.org/group2/languages/features#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/group2/languages/features">
        <owl:imports rdf:resource="http://www.semanticweb.org/group2/languages/core"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/group2/languages/core#hasMorphType -->

    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#hasMorphType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/group2/languages/features#hasTone -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/languages/features#hasTone">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/group2/languages/core#hasPhonemicFeature"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/languages/features#ToneSystem"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/languages/features#hasVowelInventory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/languages/features#hasVowelInventory">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/group2/languages/core#hasFeature"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/languages/features#VowelInventorySize"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/group2/languages/core#Vowel -->

    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Vowel">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/group2/languages/features#Consonant"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/group2/languages/features#Click -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#Click">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/features#MarkedConsonant"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ConcatenativeLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#ConcatenativeLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasMorphType"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#AblautConcatenative"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#ExclusivelyConcatenative"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#IsolatingConcatenative"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#TonalConcatenative"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#Consonant -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#Consonant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Phoneme"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#Ejective -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#Ejective">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/features#MarkedConsonant"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#IsolatingLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#IsolatingLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasMorphType"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#ExclusivelyIsolating"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#IsolatingConcatenative"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#TonalIsolating"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#LargeVowelInventoryLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#LargeVowelInventoryLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/features#hasVowelInventory"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/group2/languages/features#LargeVowelInventory"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#MarkedConsonant -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#MarkedConsonant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#Click"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#Ejective"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#Pharyngeal"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/features#Consonant"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#MarkedConsonantLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#MarkedConsonantLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasPhoneme"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/group2/languages/features#MarkedConsonant"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#MixedMorphologyFamily -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#MixedMorphologyFamily">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#LanguageFamily"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasMember"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/group2/languages/features#ConcatenativeLanguage"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasMember"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/group2/languages/features#IsolatingLanguage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#NoDominantOrderLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#NoDominantOrderLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#OVLanguage"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#VOLanguage"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#NonTonalLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#NonTonalLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/features#hasTone"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/group2/languages/features#NoTones"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/group2/languages/features#TonalLanguage"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#OVLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#OVLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasWordOrder"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#OSV"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#OVS"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#SOV"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#Pharyngeal -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#Pharyngeal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/features#MarkedConsonant"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#Q3Counterexample -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#Q3Counterexample">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#VowelHarmonyLanguage"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/group2/languages/features#LargeVowelInventoryLanguage"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#TonalIsolatingLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#TonalIsolatingLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#IsolatingLanguage"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#TonalLanguage"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#TonalLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#TonalLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/features#hasTone"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#ComplexTone"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#SimpleTone"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ToneSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#ToneSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#PhonemicFeature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#VOLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#VOLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasWordOrder"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#SVO"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#VOS"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/features#VSO"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#VowelHarmonyLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#VowelHarmonyLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/languages/core#Language"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/group2/languages/core#hasProcess"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/group2/languages/features#VowelHarmony"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/group2/languages/features#VowelInventorySize -->

    <owl:Class rdf:about="http://www.semanticweb.org/group2/languages/features#VowelInventorySize">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/group2/languages/core#Feature"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/group2/languages/features#AblautConcatenative -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#AblautConcatenative"/>
    


    <!-- http://www.semanticweb.org/group2/languages/features#AverageVowelInventory -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#AverageVowelInventory">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#VowelInventorySize"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ClickConsonant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#ClickConsonant">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#Click"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ComplexTone -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#ComplexTone">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#ToneSystem"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#EjectiveConsonant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#EjectiveConsonant">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#Ejective"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ExclusivelyConcatenative -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#ExclusivelyConcatenative">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#MorphologicalType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ExclusivelyIsolating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#ExclusivelyIsolating">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#MorphologicalType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#ExclusivelyTonal -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#ExclusivelyTonal">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#MorphologicalType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#IsolatingConcatenative -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#IsolatingConcatenative">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#MorphologicalType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#LargeVowelInventory -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#LargeVowelInventory">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#VowelInventorySize"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#NoTones -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#NoTones">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#ToneSystem"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#OSV -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#OSV">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#WordOrderType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#OVS -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#OVS">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#WordOrderType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#PharyngealConsonant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#PharyngealConsonant">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#Pharyngeal"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#SOV -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#SOV">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#WordOrderType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#SVO -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#SVO">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/core#WordOrderType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#SimpleTone -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/group2/languages/features#SimpleTone">
        <rdf:type rdf:resource="http://www.semanticweb.org/group2/languages/features#ToneSystem"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/group2/languages/features#SmallVowelInventory -->

